# ============================================================
# Server-side Environment Variables (Backend / Serverless / Dev)
# ============================================================
# The Groq API key is kept strictly server-side and never exposed to the client bundle.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# ============================================================
# Optional Client-side Environment Variables (VITE_*)
# ============================================================
# Custom proxy endpoint if backend is hosted on a different URL (defaults to /api/cosmo)
# VITE_COSMO_ENDPOINT=/api/cosmo
# Set to "true" if you want to force offline-only context brain mode in development
# VITE_COSMO_OFFLINE=false
